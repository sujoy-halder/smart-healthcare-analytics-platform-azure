{
  "title": "Smart Healthcare Analytics Overview",
  "schemaVersion": 39,
  "refresh": "30s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Ingested Records",
      "targets": [
        {
          "expr": "sum by (source_type) (rate(healthcare_ingested_records_total[5m]))",
          "legendFormat": "{{source_type}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Rejected Records",
      "targets": [
        {
          "expr": "sum by (source_type) (rate(healthcare_rejected_records_total[5m]))",
          "legendFormat": "{{source_type}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      }
    }
  ]
}
